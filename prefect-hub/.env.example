# Firebase web app config (safe to expose to the browser).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only. JSON service account for the Admin SDK (weather overrides,
# daily arrangement stickiness, audit log). Paste the JSON on one line.
# Without it, /api/weather still works: live HKO + seed rules, no overrides.
FIREBASE_SERVICE_ACCOUNT=
